# Provider selection: 'auto' (default), 'gemini', or 'ollama'
LLM_PROVIDER=auto

# Gemini Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Local Ollama Settings (Option 3 - run entirely locally on your machine)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3

PORT=3000


